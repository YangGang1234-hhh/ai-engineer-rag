# Application
APP_NAME=AI-Engineer-RAG API
APP_ENV=development
DATABASE_URL=sqlite:///./data/ai_engineer_rag.db

# Qdrant Local 会把向量索引持久化到这个项目目录。
# 不需要 Docker、WSL 或独立的 Qdrant 服务。
QDRANT_PATH=./data/qdrant
QDRANT_COLLECTION=document_chunks

# Model provider (used in a later sprint)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace_me
LLM_MODEL=replace_me

# 管理接口（文档上传/删除、审计日志、内部观测）的访问密钥。
# 使用随机长字符串；真实值只放在 .env 或部署平台密钥管理中。
ADMIN_API_KEY=replace_with_a_random_long_secret
# 本地 Embedding 模型。首次使用时会下载模型文件，之后会复用本地缓存。
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
